{
  "mcpServers": {
    "github": {
      "command": "sh",
      "args": [
        "-c",
        "export GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token 2>/dev/null || echo \"$GITHUB_PERSONAL_ACCESS_TOKEN\")\" && npx -y @modelcontextprotocol/server-github"
      ]
    },
    "brave-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "brave-mcp@latest",
        "--slim",
        "--headless",
        "--isolated",
        "--brave-arg=--no-sandbox",
        "--brave-arg=--disable-setuid-sandbox",
        "--brave-arg=--disable-dev-shm-usage",
        "--brave-arg=--disable-gpu"
      ],
      "env": {
        "BRAVE_PATH": "/usr/bin/brave-origin"
      }
    }
  }
}
