[Unit]
Description=PS Backend API Service (Go)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ps
Group=ps
WorkingDirectory=/opt/ps
ExecStart=/opt/ps/ps-api
EnvironmentFile=/etc/ps/backend.env

# Limites de Recursos e Proteção contra OOM em VM de 1GB
MemoryMax=450M
MemoryHigh=380M
CPUQuota=90%

# Reinício automático em caso de falha
Restart=always
RestartSec=5s

# Hardening de Segurança no Linux
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ps
PrivateTmp=true

# Logs redirecionados para o journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ps-api

[Install]
WantedBy=multi-user.target
