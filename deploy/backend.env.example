# Configurações do Backend PS (/etc/ps/backend.env)
PORT=8080
LOG_LEVEL=info
STORAGE_PROVIDER=oci
UPLOAD_PATH=/opt/ps/data/uploads

# OCI Object Storage (Provisionado via Terraform com PAR)
OCI_STORAGE_BUCKET=ps-files
OCI_STORAGE_NAMESPACE=
OCI_STORAGE_REGION=sa-saopaulo-1
OCI_STORAGE_ENDPOINT=

# Domínios e CORS (Produção)
ALLOWED_ORIGINS=https://ps.yurinogueira.dev.br
COOKIE_DOMAIN=.yurinogueira.dev.br
COOKIE_SECURE=true

# MongoDB Atlas (Substitua pela connection string gerada no Terraform output 'mongodb_uri')
MONGO_URI=mongodb+srv://ps_app:<SENHA>@ps-cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=ps

# Secrets de Autenticação JWT (Gere com: openssl rand -base64 32)
JWT_SECRET=substitua_por_uma_chave_secreta_jwt_forte
JWT_REFRESH_SECRET=substitua_por_uma_chave_secreta_refresh_forte

# Notificações e E-mail (SMTP Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=no-reply@yurinogueira.dev.br
APP_BASE_URL=https://ps.yurinogueira.dev.br
